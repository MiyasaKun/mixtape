# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
GUILD_ID=

# Database & cache
DATABASE_URL=postgres://user:pass@localhost:5432/discord_bot
REDIS_URL=redis://localhost:6379

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Auth
AUTH_ENCRYPTION_KEY=
SESSION_TTL=720h

# Server
PORT=:3000
ENV=development

# OpenTelemetry: leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable
# telemetry entirely (signals are never exported). When set, OTLP HTTP
# base endpoint; /v1/metrics and /v1/logs are appended internally.
# With the observability compose profile up, use: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mixtape

# Grafana (observability compose profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
